{
  "homepage": "./",
  "name": "luckyshot-desktop",
  "version": "1.0.9",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "build-react": "cd frontend && npm run build",
    "dist": "npm run build-react && electron-builder --publish always"
  },

  "dependencies": {
    "electron-updater": "^6.1.4"
  },

  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.1"
  },

  "build": {
    "appId": "com.luckyshot.desktop",
    "productName": "LuckyShot",

    "publish": [
      {
        "provider": "github",
        "owner": "Panda5og",
        "repo": "luckyshotph",
        "releaseType": "release"
      }
    ],

    "files": [
      "frontend/build/**/*",
      "main.js",
      "package.json"
    ],

    "win": {
      "target": "nsis",
      "icon": "frontend/public/icon.ico"
    }
  }
}
